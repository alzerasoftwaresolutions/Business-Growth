# Copy to .env.local (not committed) with real values.
# Public measurement ID for optional analytics — leave empty to disable.
VITE_GA_MEASUREMENT_ID=
# Canonical production domain, e.g. https://www.example.com
# Drives runtime canonical/OG meta and the build-time static rewrite
# (index.html, sitemap.xml, robots.txt, llms.txt) via scripts/sync-domain.mjs.
VITE_SITE_URL=
# Contact-form delivery endpoint (JSON POST). Leave empty to simulate submissions.
VITE_FORM_ENDPOINT=