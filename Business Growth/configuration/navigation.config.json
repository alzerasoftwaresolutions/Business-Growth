    "hideDisabledFeatures": true,

    "hideDisabledPages": true,

    "preventBrokenLinks": true,

    "preventLinksToDisabledFeatures": true,

    "preserveLogicalHierarchy": true,

    "mobileAndDesktopMustRemainConsistent": true,

    "allowDifferentMobileOrdering": true,

    "allowClientSpecificLabels": true,

    "allowExternalLinks": true,

    "externalLinksOpenInNewTab": true
  },

  "externalLinks": [],

  "redirects": [],

  "accessibility": {
    "keyboardNavigation": true,

    "ariaLabelsRequired": true,

    "currentPageIndicator": true,

    "focusVisible": true,

    "skipToContent": true
  }
