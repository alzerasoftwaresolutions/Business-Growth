# Copy to .env.local (not committed) with real values.
# Only VITE_* values are exposed to the client bundle. Never put secrets here.

# Canonical production domain, e.g. https://www.example.com
VITE_SITE_URL=

# Public measurement ID for optional analytics — leave empty to disable.
VITE_GA_MEASUREMENT_ID=

# Lead-delivery endpoint (JSON POST). Leave empty when backend.enabled = false.
# The integration boundary uses this only when a backend is enabled.
VITE_FORM_ENDPOINT=
